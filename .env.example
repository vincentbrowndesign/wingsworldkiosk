# Wings World kiosk — set these in the Vercel project. Never commit real values.
KIOSK_KEY=            # long random string; the tablet opens /?key=KIOSK_KEY once
STAFF_CODE=           # code owner/manager type on the answer page
CALL_CHANNEL=         # long random string; keeps the call channel name private
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=     # npm run vapid
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@vincentbrownpresents.com
# Optional relay for calls on networks that block direct connections
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
